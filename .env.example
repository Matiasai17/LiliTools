# Variables de build del hub (Vite). Copiá a ".env" en local, o cargalas en el
# panel del hosting al buildear. Solo las que empiezan con VITE_ llegan al cliente.

# URL pública del backend compartido de LiliTools (ver server/artwork-finder),
# que sirve tanto al "Buscador de artworks" como a "Sugerí una mejora".
# En desarrollo, si no la definís, se usa http://localhost:3000.
# En producción es OBLIGATORIA para que ambas funcionen desde la web desplegada.
# Ej: VITE_HUB_API_BASE=https://api.tudominio.com
VITE_HUB_API_BASE=
